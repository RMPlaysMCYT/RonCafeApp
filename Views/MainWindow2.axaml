<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="1080"
        x:Class="RonCafeApp.Views.MainWindow2"
        Title="RonCafeLauncherLayout2">
        <Grid>
                <!-- ~1~ Background: Show wallpaper OR solid color @1@ -->
                <!-- <Grid> -->
                <!--         ~1~ Solid color background (visible when NO wallpaper) @1@ -->
                <!--         <Rectangle Fill="{Binding LauncherBackground}" -->
                <!--                    IsVisible="{Binding WallpaperBrush, Converter={x:Static ObjectConverters.IsNull}}" /> -->
                <!-- -->
                <!--         ~1~ Wallpaper (visible when wallpaper exists) @1@ -->
                <!--         <Image Source="{Binding WallpaperPath, Converter={StaticResource BitmapConv}}" -->
                <!--                Stretch="UniformToFill" -->
                <!--                Opacity="0.85" -->
                <!--                IsVisible="{Binding WallpaperBrush, Converter={x:Static ObjectConverters.IsNotNull}}" /> -->
                <!-- </Grid> -->
                <Grid RowDefinitions="80 * 730">
                        <Border Grid.Row="0"
                                Padding="20">
                                <StackPanel 
Orientation="Horizontal" 
HorizontalAlignment="Right">
                                        <!-- Using built-in part names for automatic window handling -->
                                        <Button Name="PART_MinimizeButton" Content="—" />
                                        <Button Name="PART_MaximizeButton" Content="[ ]" />
                                        <Button Name="PART_CloseButton" Content="X" Background="Red" />
                                </StackPanel>
                        </Border>
                        <Border Grid.Row="1"
                                Padding="20">
                                <AutoCompleteBox 
Width="500" 
Padding="0 0 0 0"
></AutoCompleteBox>
                        </Border>
                        <Grid Grid.Row="2" HorizontalAlignment="Center">
                                <TabControl Margin="5">
                                        <TabItem Header="Tab 1">
                                                <TextBlock Margin="5">This is tab 1 content</TextBlock>
                                        </TabItem>
                                        <TabItem Header="Tab 2">
                                                <TextBlock Margin="5">This is tab 2 content</TextBlock>
                                        </TabItem>
                                </TabControl>
                        </Grid>
                </Grid>
        </Grid>
</Window>
